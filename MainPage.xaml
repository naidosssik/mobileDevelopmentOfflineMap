<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OfflineMapApp.MainPage"
    Title="Offline Map">

    <Grid
        RowDefinitions="Auto,*,Auto"
        ColumnDefinitions="*,300">

        <!-- Верхняя панель -->

        <Grid
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Padding="20,15"
            ColumnDefinitions="*,Auto">

            <Label
                Text="Offline Map"
                FontSize="24"
                FontAttributes="Bold"
                VerticalOptions="Center" />

            <Button
                Grid.Column="1"
                Text="Открыть фото" />

        </Grid>


        <!-- Область карты -->

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="10"
            StrokeThickness="1">

            <Grid>

                <Label
                    Text="Здесь будет карта OpenStreetMap"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    FontSize="20" />

            </Grid>

        </Border>


        <!-- Правая панель -->

        <VerticalStackLayout
            Grid.Row="1"
            Grid.Column="1"
            Padding="15"
            Spacing="12">

            <Label
                Text="Мои точки"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                Text="Пока точек нет"
                FontSize="14" />

            <Button
                Text="+ Добавить точку" />

            <Button
                Text="Моё местоположение" />

            <Button
                Text="Скачать область" />

        </VerticalStackLayout>


        <!-- Нижняя строка -->

        <Grid
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Padding="20,10"
            ColumnDefinitions="*,*">

            <Label
                Text="GPS: не определён" />

            <Label
                Grid.Column="1"
                Text="Оффлайн: нет"
                HorizontalOptions="End" />

        </Grid>

    </Grid>

</ContentPage>