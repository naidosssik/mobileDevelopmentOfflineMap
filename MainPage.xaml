<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
    x:Class="OfflineMapApp.MainPage"
    Title="Offline Map">

    <Grid
        RowDefinitions="Auto,*,Auto"
        ColumnDefinitions="*,300">

        <!-- Верхняя панель -->
        <Grid
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Padding="20,15"
            ColumnDefinitions="*,Auto">

            <Label
                Text="Карта с точками и оффлайн-режим"
                FontSize="24"
                FontAttributes="Bold"
                VerticalOptions="Center" />

            <Button
                Grid.Column="1"
                Text="Открыть фото" />

        </Grid>

        <!-- Карта -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="10"
            StrokeThickness="1">

            <Grid>

                <!-- Карта -->
                <mapsui:MapControl
                    x:Name="MapView"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />

                <!-- Кнопки масштабирования -->
                <VerticalStackLayout
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,20,20"
                    Spacing="8">

                    <Button
                        Text="+"
                        WidthRequest="50"
                        HeightRequest="50"
                        FontSize="24"
                        FontAttributes="Bold"
                        Clicked="ZoomIn_Clicked" />

                    <Button
                        Text="−"
                        WidthRequest="50"
                        HeightRequest="50"
                        FontSize="24"
                        FontAttributes="Bold"
                        Clicked="ZoomOut_Clicked" />

                </VerticalStackLayout>

            </Grid>

        </Border>

        <!-- Правая панель -->
        <VerticalStackLayout
            Grid.Row="1"
            Grid.Column="1"
            Padding="15"
            Spacing="12">

            <Label
                Text="Мои точки"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                x:Name="EmptyPointsLabel"
                Text="Пока точек нет"
                FontSize="14"
                TextColor="Gray" />

            <CollectionView
                x:Name="PointsCollectionView"
                HeightRequest="300"
                SelectionMode="Single"
                SelectionChanged="PointsCollectionView_SelectionChanged">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            Padding="10"
                            Margin="0,0,0,8">

                            <Grid
                                RowDefinitions="Auto,Auto"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="10"
                                RowSpacing="8">

                                <!-- Маркер -->
                                <Label
                                    Text="●"
                                    FontSize="18"
                                    VerticalOptions="Center" />

                                <!-- Название и координаты -->
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2">

                                    <Label
                                        Text="{Binding Name}"
                                        FontAttributes="Bold"
                                        FontSize="15" />

                                    <Label
                                        Text="{Binding CoordinatesText}"
                                        FontSize="12"
                                        TextColor="Gray" />

                                </VerticalStackLayout>

                                <!-- Кнопки -->
                                <HorizontalStackLayout
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Spacing="8">

                                    <Button
                                        Text="Перейти"
                                        FontSize="12"
                                        Padding="10,5"
                                        CommandParameter="{Binding .}"
                                        Clicked="GoToPoint_Clicked" />

                                    <Button
                                        Text="Удалить"
                                        FontSize="12"
                                        Padding="10,5"
                                        CommandParameter="{Binding .}"
                                        Clicked="DeletePoint_Clicked" />

                                </HorizontalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button
                Text="+ Добавить точку"
                Clicked="AddPoint_Clicked" />

            <Button
                Text="Моё местоположение" />

            <Button
                Text="Скачать область" />

        </VerticalStackLayout>

        <!-- Нижняя строка -->
        <Grid
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Padding="20,10"
            ColumnDefinitions="*,*">

            <Label
                Text="GPS: не определён" />

            <Label
                Grid.Column="1"
                Text="Оффлайн: нет"
                HorizontalOptions="End" />

        </Grid>

    </Grid>

</ContentPage>